{
  "name": "taleemxpress",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd apps/server && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "db:push": "cd apps/server && npx drizzle-kit push",
    "seed": "cd apps/server && node src/db/seed.js",
    "e2e": "node scripts/e2e-test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
